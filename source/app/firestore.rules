rules_version = '2';
// Règles de sécurité de l'application Igna Djongo.
// - Il faut un compte ET le code de l'igna pour voir quoi que ce soit.
// - Seuls les trésoriers enregistrent ou suppriment des paiements.
// - Les responsables gèrent les rôles, le code de l'igna et peuvent retirer un membre.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function hasAccess() { return signedIn() && exists(/databases/$(database)/documents/access/$(me())); }
    function roles() { return get(/databases/$(database)/documents/config/roles).data; }
    function noRolesYet() { return !exists(/databases/$(database)/documents/config/roles); }
    function isAdmin() { return hasAccess() && !noRolesYet() && me() in roles().admins; }
    function isTreasurer() { return hasAccess() && !noRolesYet() && me() in roles().tresoriers; }
    function str(v, max) { return v is string && v.size() <= max; }
    // Le compte est créé avec « numéro@igna-djongo.app » : on peut donc vérifier
    // qu'une fiche porte bien le même numéro que le compte.
    function myTel() { return request.auth.token.email; }
    function isBanned() { return exists(/databases/$(database)/documents/bannis/$(me())); }
    // « Code oublié » : le responsable donne un code de réinitialisation. Le membre crée alors
    // un nouveau compte « numéro-rN@igna-djongo.app » (N = comptes/{numéro}.n) avec son nouveau code.
    function comptesDoc(tel) { return /databases/$(database)/documents/comptes/$(tel); }
    function resetDoc(tel) { return /databases/$(database)/documents/resets/$(tel); }
    function isRenewed(tel) {
      return exists(comptesDoc(tel)) && myTel() == tel + '-r' + string(get(comptesDoc(tel)).data.n) + '@igna-djongo.app';
    }
    function telOk(tel) { return myTel() == tel + '@igna-djongo.app' || isRenewed(tel); }

    // Un document par compte autorisé. On le crée avec le bon code de l'igna
    // (ou sans code pour le tout premier compte, qui devient responsable).
    match /access/{userId} {
      allow get: if signedIn() && (userId == me() || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && userId == me()
        && request.resource.data.keys().hasOnly(['code', 'at', 'tel'])
        && str(request.resource.data.code, 30)
        && !isBanned()
        && (noRolesYet() || exists(/databases/$(database)/documents/invites/$(request.resource.data.code))
            // ou avec le code de réinitialisation donné par un responsable
            || ('tel' in request.resource.data && str(request.resource.data.tel, 30)
                && isRenewed(request.resource.data.tel) && exists(resetDoc(request.resource.data.tel))
                && get(resetDoc(request.resource.data.tel)).data.code == request.resource.data.code));
      // un responsable ne peut pas se retirer lui-même l'accès
      allow delete: if isAdmin() && userId != me();
      allow update: if false;
    }

    // Comptes retirés par un responsable : ils ne peuvent plus revenir, même avec le code.
    match /bannis/{userId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && userId != me() && request.resource.data.keys().hasOnly(['at']);
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Numéro de version du compte de chaque numéro (après un « code oublié »).
    // Lisible sans être connecté : il sert à se connecter.
    match /comptes/{tel} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n is int && request.resource.data.n > 0
        && (resource == null || request.resource.data.n > resource.data.n);
      allow delete: if false;
    }
    // Code de réinitialisation en attente. old = l'ancien compte, pour lui reprendre ses rôles.
    match /resets/{tel} {
      allow get: if isAdmin() || (signedIn() && isRenewed(tel));
      allow list: if false;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['code', 'old', 'member', 'at'])
        && str(request.resource.data.code, 12) && str(request.resource.data.old, 128)
        && str(request.resource.data.member, 60) && str(request.resource.data.at, 10);
      allow delete: if isAdmin() || (hasAccess() && isRenewed(tel));
    }

    // Les codes valides. On peut vérifier un code précis, jamais lister.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isAdmin() || (hasAccess() && noRolesYet());
      allow delete: if isAdmin();
      allow update: if false;
    }

    function swapped(l, old) { return old in l ? l.removeAll([old]).concat([me()]) : l; }
    function rolesSwapOk() {
      let tel = get(/databases/$(database)/documents/access/$(me())).data.tel;
      let old = get(resetDoc(tel)).data.old;
      return isRenewed(tel)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['admins', 'tresoriers'])
        && request.resource.data.admins == swapped(resource.data.admins, old)
        && request.resource.data.tresoriers == swapped(resource.data.tresoriers, old);
    }
    match /config/roles {
      allow get: if hasAccess();
      allow create: if hasAccess() && noRolesYet()
        && request.resource.data.admins == [me()]
        && request.resource.data.tresoriers == [me()];
      allow update: if (isAdmin()
        && request.resource.data.admins is list && request.resource.data.admins.size() > 0
        && request.resource.data.tresoriers is list)
        // après un « code oublié » : le nouveau compte reprend les rôles de l'ancien
        || (hasAccess() && rolesSwapOk());
      allow delete: if false;
    }
    match /config/invite {
      allow get: if hasAccess();
      allow create: if isAdmin() || (hasAccess() && noRolesYet());
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /config/settings {
      allow get: if hasAccess();
      allow write: if isTreasurer() || isAdmin();
    }

    function validMember() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nom', 'famille', 'tel', 'telKey', 'ville', 'lieu', 'role', 'uid', 'photo'])
        && str(d.nom, 120) && d.nom.size() > 0 && str(d.famille, 120) && str(d.tel, 40)
        && str(d.ville, 120) && d.lieu in ['comores', 'diaspora']
        && str(d.get('telKey', ''), 30) && str(d.get('role', ''), 60)
        && str(d.get('photo', ''), 100000);
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    match /members/{id} {
      allow read: if hasAccess();
      // une fiche liée à un compte doit porter le numéro de ce compte
      allow create: if hasAccess() && validMember()
        && (!('uid' in request.resource.data)
            || (request.resource.data.uid == me() && telOk(request.resource.data.telKey)));
      allow update: if hasAccess() && validMember() && (
        // un responsable ou un trésorier, sans toucher au lien avec le compte
        ((isAdmin() || isTreasurer()) && !changed().hasAny(['uid']))
        // un responsable qui donne un nouveau code détache l'ancien compte
        || (isAdmin() && changed().hasOnly(['uid']) && !('uid' in request.resource.data)
            && existsAfter(resetDoc(resource.data.telKey)))
        // la personne elle-même : ses informations et sa photo, pas son rôle ni le lien
        || (resource.data.get('uid', null) == me()
            && changed().hasOnly(['nom', 'famille', 'tel', 'telKey', 'ville', 'lieu', 'photo']))
        // quelqu'un qui crée son compte et retrouve sa fiche : seulement si c'est son numéro
        || (resource.data.get('uid', null) == null && request.resource.data.uid == me()
            && telOk(resource.data.telKey)
            && changed().hasOnly(['uid']))
      );
      allow delete: if isAdmin();
    }

    // Un document par mois, avec la liste des paiements et sorties du mois.
    match /ledger/{month} {
      allow read: if hasAccess();
      allow write: if isTreasurer();
    }

    // « J'ai cotisé » : un membre déclare son propre paiement, le trésorier le confirme
    // (il l'écrit alors dans ledger) ou le refuse. Le membre peut annuler sa déclaration.
    match /declarations/{id} {
      allow read: if hasAccess();
      allow create: if hasAccess() && validDeclaration();
      allow delete: if isTreasurer() || (hasAccess() && resource.data.uid == me());
      allow update: if false;
    }
    function validDeclaration() {
      let d = request.resource.data;
      let m = /databases/$(database)/documents/members/$(d.memberId);
      return d.keys().hasOnly(['memberId', 'uid', 'montant', 'devise', 'date', 'cat', 'moyen', 'note', 'at', 'collecte'])
        && str(d.get('collecte', ''), 60)
        && d.uid == me() && str(d.memberId, 60) && exists(m) && get(m).data.get('uid', null) == me()
        && (d.montant is number) && d.montant > 0 && d.montant <= 10000000
        && d.devise in ['EUR', 'KMF'] && d.cat in ['mensuelle', 'evenement', 'don']
        && str(d.date, 10) && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && str(d.moyen, 60) && str(d.note, 200) && str(d.at, 10);
    }

    // Annonces (réunion, grand mariage, wukumbi, événement, décès, collecte, information) : tout membre peut publier ;
    // seuls l'auteur et les responsables peuvent modifier ou supprimer.
    function validAnnonce() {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'titre', 'texte', 'date', 'lieu', 'auteur', 'auteurUid', 'at', 'ts'])
        && d.type in ['reunion', 'anda', 'wukumbi', 'evenement', 'deces', 'collecte', 'info']
        && str(d.titre, 200) && d.titre.size() > 0 && str(d.get('texte', ''), 5000)
        && str(d.get('date', ''), 10) && str(d.get('lieu', ''), 200) && str(d.get('auteur', ''), 60)
        && str(d.at, 10) && d.ts is int;
    }
    match /annonces/{id} {
      allow read: if hasAccess();
      allow create: if hasAccess() && request.resource.data.auteurUid == me() && validAnnonce();
      allow update: if hasAccess() && (resource.data.auteurUid == me() || isAdmin())
        && !changed().hasAny(['auteurUid', 'auteur', 'at', 'ts']) && validAnnonce();
      allow delete: if hasAccess() && (resource.data.auteurUid == me() || isAdmin());
    }

    // Collectes par projet : lancées et gérées par les trésoriers et les responsables.
    // Les participations sont des paiements du registre (ledger) qui portent l'identifiant de la collecte.
    function validCollecte() {
      let d = request.resource.data;
      return d.keys().hasOnly(['titre', 'texte', 'objectif', 'devise', 'fin', 'ouverte', 'auteurUid', 'at', 'ts'])
        && str(d.titre, 200) && d.titre.size() > 0 && str(d.get('texte', ''), 5000)
        && d.objectif is number && d.objectif > 0 && d.objectif <= 100000000
        && d.devise in ['EUR', 'KMF'] && str(d.get('fin', ''), 10) && d.ouverte is bool
        && str(d.at, 10) && d.ts is int;
    }
    match /collectes/{id} {
      allow read: if hasAccess();
      allow create: if (isTreasurer() || isAdmin()) && request.resource.data.auteurUid == me() && validCollecte();
      allow update: if (isTreasurer() || isAdmin()) && !changed().hasAny(['auteurUid', 'at', 'ts']) && validCollecte();
      allow delete: if isAdmin();
    }

    function validChapter() {
      let d = request.resource.data;
      return d.keys().hasOnly(['titre', 'texte', 'periode', 'annee', 'ordre', 'auteur', 'auteurUid', 'ajoute', 'exemple'])
        && str(d.titre, 200) && str(d.texte, 20000) && str(d.get('periode', ''), 60);
    }
    match /histoire/{id} {
      allow read: if hasAccess();
      allow create: if hasAccess() && request.resource.data.auteurUid == me() && validChapter();
      // seuls l'auteur du chapitre et les responsables peuvent le modifier
      allow update: if hasAccess() && (resource.data.auteurUid == me() || isAdmin())
        && !changed().hasAny(['auteurUid', 'auteur', 'ajoute', 'ordre']) && validChapter();
      allow delete: if hasAccess() && (resource.data.auteurUid == me() || isAdmin());
    }
  }
}
